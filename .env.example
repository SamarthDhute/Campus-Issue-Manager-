# Smart Campus Issue Manager - Environment Variables
# Copy this file to .env and replace with your actual configuration

# Server Configuration
PORT=8081

# Supabase Cloud Database (PostgreSQL)
SUPABASE_DB_URL=jdbc:postgresql://<db-host>.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=<your-db-password>

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Future Phases (Supabase Storage, Gemini LLM, Firebase)
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_SERVICE_KEY=<your-service-role-key>
GEMINI_API_KEY=<your-gemini-api-key>
